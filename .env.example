# 複製為 .env（已被 .gitignore 忽略），填入實際值。

# Gemini 金鑰——AI 判定端點（/api/judge、/api/rejudge、/api/notify、
# 非同步 /v1/inspections）需要；不填則這些端點回 503，其餘功能照常。
GEMINI_API_KEY=

# 整備任務通知 webhook（選填）。設定後，人工 confirm 建立任務時 server 會對此
# URL 發 HTTP POST JSON（4 秒 timeout；失敗不影響任務建立，可在整備看板重發）。
# 未設定時任務標示「通知管道未設定」。本機測試：
#   python3 backend/tools/webhook_receiver.py   → 用 http://127.0.0.1:9999/hook
# URL 屬機密（可能含 token），只放這裡，勿寫進程式碼或 log。
# NOTIFICATION_WEBHOOK_URL=

# 設 1 開啟 Swagger UI（/docs）、/redoc、/openapi.json；預設關閉。
# 僅在本機開發、未對外時開啟——server 無認證，資料含真實車牌。
# IRENT_ENABLE_DOCS=1

# 原始照片資料集根目錄。本機開發不用設（預設 repo 根下的資料夾）。
# docker-compose.yml 已設為 /dataset 並把資料夾唯讀掛進去。
# IRENT_DATASET_ROOT=

# --- PR #2（Postgres）啟用後再填 ---
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://irent:CHANGEME@postgres:5432/irent
